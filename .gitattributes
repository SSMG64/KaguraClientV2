# Default text handling
* text=auto

# Source and configuration files
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.hxx text eol=lf
*.inl text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Treat compiled/binary files as binary
*.7z binary
*.bin binary
*.db binary
*.dll binary
*.exe binary
*.ipch binary
*.lib binary
*.o binary
*.pdb binary
*.sprx binary
*.suo binary
*.vsidx binary
*.zip binary
